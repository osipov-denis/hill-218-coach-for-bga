{
  "manifest_version": 3,
  "name": "Hill 218 Coach for BGA",
  "version": "0.1.0",
  "description": "Read-only card counter and visible-log helper for The Battle for Hill 218 on Board Game Arena.",
  "content_scripts": [
    {
      "matches": ["https://boardgamearena.com/*", "https://*.boardgamearena.com/*"],
      "js": ["src/cardModel.js", "src/content.js"],
      "css": ["src/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [],
  "host_permissions": []
}
